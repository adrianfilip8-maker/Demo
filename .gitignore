node_modules/
dist/
.vite/
*.log
.DS_Store

# Screenshot iterations from the critic loop — only the latest curated set is committed.
# `shots/` is already ~159 MB; agents each produce tens of MB of intermediate frames per run,
# and none of it is evidence anyone reads twice. The curated top-level shots/*.png and the
# scored critic sets (shots/pass*/) are the record; everything below is working output.
#
# Stated as "ignore every subdirectory, re-include the ones that are evidence" rather than as
# a list of agent prefixes. Enumerating prefixes fails every time an agent picks a new name —
# it already missed it0-base/, sw2/, fx0/ and geo0/ in turn.
shots/*/
!shots/pass1/
!shots/pass2/

# Detached capture runs write pid files next to their logs; a compound `cd && nohup … &`
# backgrounds the whole list, so the trailing `echo $! > run.pid` runs back in the repo
# root — twice now. Runtime state, never source.
*.pid

# keeplog.sh (tools/keeplog.sh, KNOWN_ISSUES §88/§89.5) writes preserved capture logs here.
# They MUST be tracked — that is the entire point of the tool, and the *.log rule above
# silently defeated it on first use.
!progress/records/logs/
!progress/records/logs/*.log
__pycache__/

# Capture frames from tools/heroread.mjs. Same rule as `shots/`: raw capture output does not
# enter git history. The CURATED evidence for a record goes in `progress/records/` as a
# downscaled composite (AB-heroread-run1.png, AB-courtyardread-run1.png) — a few hundred KB
# instead of 12 MB, and legible without a checkout. KNOWN_ISSUES §272.4.
progress/records/heroread/*.png

# Every OTHER seal's raw capture frames, by the same rule — generalised from heroread/ because
# naming one run at a time fails exactly the way the `shots/` prefix list failed: it already
# missed fxartifact1/, fxfix1/, gradetrio1/, lithold1/, redkey/ and torchlight1/, which stood
# at 748 MB of untracked frames between them. A seal's DURABLE evidence is its RESULT-*.md, its
# scorer log under progress/records/logs/ and its manifest.json (tree stamp, readbacks, probe
# data, console errors — tens of KB, re-included below). The frames are regenerable by re-running
# the seal and are not read twice; shots/r13/ is already ignored under the same policy, and the
# §326-refuting measurements in §328 live in the RESULT as numbers, not as PNGs.
# KNOWN_ISSUES §272.4, §328.
# The `*/**/` shape (not a bare `**/`) is deliberate: it requires at least one run directory,
# so it catches both <run>/frame.png and <run>/crops/frame.png while leaving the CURATED
# composites that live directly in progress/records/*.png tracked, which is the whole point.
progress/records/*/**/*.png
!progress/records/*/manifest.json
